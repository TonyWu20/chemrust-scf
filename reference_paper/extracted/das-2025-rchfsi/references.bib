
@article{ipsenProbabilisticErrorAnalysis2020,
	title = {Probabilistic {Error} {Analysis} for {Inner} {Products}},
	volume = {41},
	issn = {0895-4798},
	url = {https://epubs.siam.org/doi/10.1137/19M1270434},
	doi = {10.1137/19M1270434},
	abstract = {Stochastic rounding rounds a real number to the next larger or smaller floating-point number with probabilities 1 minus the relative distances to those numbers. It is gaining attention in deep learning because it can increase the success of low precision computations. We compare basic properties of stochastic rounding with those for round to nearest, finding properties in common as well as significant differences. We prove that for stochastic rounding the rounding errors are mean independent random variables with zero mean. We derive a new version of our probabilistic error analysis theorem from [N. J. Higham and T. Mary, SIAM J. Sci. Comput., 41 (2019), pp. A2815--A2835], weakening the assumption of independence of the random variables to mean independence. These results imply that for a wide range of linear algebra computations the backward error for stochastic rounding is unconditionally bounded by a multiple of \${\textbackslash}sqrt\{n\}{\textbackslash}mkern1muu\$ to first order, with a certain probability, where \$n\$ is the problem size and \$u\$ is the unit roundoff. This is the first scenario where the rule of thumb that one can replace \$nu\$ by \${\textbackslash}sqrt\{n\}{\textbackslash}mkern1muu\$ in a rounding error bound has been shown to hold without any additional assumptions on the rounding errors. We also explain how stochastic rounding avoids the phenomenon of stagnation in sums, whereby small addends are obliterated by round to nearest when they are too small relative to the sum.},
	number = {4},
	urldate = {2025-11-20},
	journal = {SIAM Journal on Matrix Analysis and Applications},
	author = {Ipsen, Ilse C. F. and Zhou, Hua},
	month = jan,
	year = {2020},
	note = {Publisher: Society for Industrial and Applied Mathematics},
	pages = {1726--1741},
}

