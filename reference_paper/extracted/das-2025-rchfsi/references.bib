}

@article{goldmanLightinducedGaugeFields2014,
	title = {Light-induced gauge fields for ultracold atoms},
	volume = {77},
	issn = {00344885},
	doi = {10.1088/0034-4885/77/12/126401},
	abstract = {Gauge fields are central in our modern understanding of physics at all scales. At the highest energy scales known, the microscopic universe is governed by particles interacting with each other through the exchange of gauge bosons. At the largest length scales, our universe is ruled by gravity, whose gauge structure suggests the existence of a particle - the graviton - that mediates the gravitational force. At the mesoscopic scale, solid-state systems are subjected to gauge fields of different nature: materials can be immersed in external electromagnetic fields, but they can also feature emerging gauge fields in their low-energy description. In this review, we focus on another kind of gauge field: those engineered in systems of ultracold neutral atoms. In these setups, atoms are suitably coupled to laser fields that generate effective gauge potentials in their description. Neutral atoms "feeling" laser-induced gauge potentials can potentially mimic the behavior of an electron gas subjected to a magnetic field, but also, the interaction of elementary particles with non-Abelian gauge fields. Here, we review different realized and proposed techniques for creating gauge potentials - both Abelian and non-Abelian - in atomic systems and discuss their implication in the context of quantum simulation. While most of these setups concern the realization of background and classical gauge potentials, we conclude with more exotic proposals where these synthetic fields might be made dynamical, in view of simulating interacting gauge theories with cold atoms.},
	number = {12},
	urldate = {2018-06-07},
	journal = {Reports on Progress in Physics},
	author = {Goldman, N and Juzeliunas, G. and Öhberg, P. and Spielman, I B},
	year = {2014},
	pmid = {25422950},
	note = {arXiv: 1308.6533
ISBN: 0034-4885},
	keywords = {gauge potentials, light-matter interaction, ultracold atoms},
}

@article{bakrProbingSuperfluidToMott2010,
	title = {Probing the {Superfluid} -to-{Mott} {Insulator} {Transition} at the {Single}-{Atom} {Level}},
	volume = {329},
	issn = {00368075},
	url = {http://www.jstor.org/stable/40799640},
	doi = {10.1126/science.1191700},
	abstract = {Recent theoretical proposals suggest that strain can be used to engineer graphene electronic states through the creation of a pseudo–magnetic field. This effect is unique to graphene because of its massless Dirac fermion-like band structure and particular lattice symmetry (C3v). Here, we present experimental spectroscopic measurements by scanning tunneling microscopy of highly strained nanobubbles that form when graphene is grown on a platinum (111) surface. The nanobubbles exhibit Landau levels that form in the presence of strain-induced pseudo–magnetic fields greater than 300 tesla. This demonstration of enormous pseudo–magnetic fields opens the door to both the study of charge carriers in previously inaccessible high magnetic field regimes and deliberate mechanical control over electronic structure in graphene or so-called “strain engineering.”},
	number = {June},
	urldate = {2018-06-14},
	journal = {Science},
	author = {Bakr, Waseem S and Peng, A and Tai, M E and Simon, J and Gillen, J I and Folling, S and Pollet, L and Greiner, Markus},
	year = {2010},
	pmid = {20671183},
	note = {ISBN: 0036-8075},
	pages = {547--550},
}

@article{huangExperimentalRealizationTwodimensional2016,
	title = {Experimental realization of two-dimensional synthetic spin-orbit coupling in ultracold {Fermi} gases},
	volume = {12},
	issn = {17452481},
	url = {http://www.nature.com/articles/nphys3672},
	doi = {10.1038/nphys3672},
	abstract = {Spin-orbit coupling (SOC) is central to many physical phenomena, including fine structures of atomic spectra and quantum topological matters. Whereas SOC is in general fixed in a physical system, atom-laser interaction provides physicists a unique means to create and control synthetic SOC for ultracold atoms {\textbackslash}cite\{Dalibard\}. Though significant experimental progresses have been made, a bottleneck in current studies is the lack of a two-dimensional (2D) synthetic SOC, which is crucial for realizing high-dimensional topological matters. Here, we report the experimental realization of 2D SOC in ultracold \${\textasciicircum}\{40\}\$K Fermi gases using three lasers, each of which dresses one atomic hyperfine spin state. Through spin injection radio-frequency (rf) spectroscopy, we probe the spin-resolved energy dispersions of dressed atoms, and observe a highly controllable Dirac point created by the 2D SOC. Our work paves the way for exploring high-dimensional topological matters in ultracold atoms using Raman schemes.},
	number = {6},
	urldate = {2018-06-14},
	journal = {Nature Physics},
	author = {Huang, Lianghui and Meng, Zengming and Wang, Pengjun and Peng, Peng and Zhang, Shao Liang and Chen, Liangchao and Li, Donghao and Zhou, Qi and Zhang, Jing},
	month = jun,
	year = {2016},
	note = {arXiv: 1506.02861
Publisher: Nature Publishing Group
ISBN: 1745-2473},
	keywords = {Atomic and molecular interactions with photons, Ultracold gases},
	pages = {540--544},
}

@article{umucalilarTrappedFermiGases2008,
	title = {Trapped fermi gases in rotating optical lattices: {Realization} and detection of the topological hofstadter insulator},
	volume = {100},
	issn = {00319007},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.100.070402},
	doi = {10.1103/PhysRevLett.100.070402},
	abstract = {We consider a gas of noninteracting spinless fermions in a rotating optical lattice and calculate the density profile of the gas in an external confinement potential. The density profile exhibits distinct plateaus, which correspond to gaps in the single particle spectrum known as the Hofstadter butterfly. The plateaus result from insulating behavior whenever the Fermi energy lies within a gap. We discuss the necessary conditions to realize the Hofstadter insulator in a cold atom setup and show how the quantized Hall conductance can be measured from density profiles using the Streda formula.},
	number = {7},
	urldate = {2018-06-07},
	journal = {Physical Review Letters},
	author = {Umucalilar, R. O. and Zhai, Hui and Oktel, M. Ö.},
	month = feb,
	year = {2008},
	pmid = {18352527},
	note = {arXiv: 0711.3705
Publisher: American Physical Society
ISBN: 0031-9007},
	pages = {070402},
}

