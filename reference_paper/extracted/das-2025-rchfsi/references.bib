oxygen deficiency (high oxygen vacancy concentration) than in LSCF, which can reach},
	number = {2},
	urldate = {2017-01-18},
	author = {Merkle, Rotraut and Mastrikov, Yuri A and Kotomin, Eugene A and Kuklja, Maija M and Maier, Joachim},
	year = {2012},
	keywords = {BSCF, SOFC cathode, first-principles DFT calculations, ionic conductivity, oxygen nonstoichiometry, oxygen permeation membrane, oxygen vacancy diffusion},
}

