@article{liDesigningLightelementMaterials2022,
	title = {Designing light-element materials with large effective spin-orbit coupling},
	volume = {13},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-022-28534-y},
	doi = {10.1038/s41467-022-28534-y},
	abstract = {{\textless}p{\textgreater} Spin-orbit coupling (SOC), which is the core of many condensed-matter phenomena such as nontrivial band gap and magnetocrystalline anisotropy, is generally considered appreciable only in heavy elements. This is detrimental to the synthesis and application of functional materials. Therefore, amplifying the SOC effect in light elements is crucial. Herein, focusing on 3 {\textless}italic{\textgreater}d{\textless}/italic{\textgreater} and 4 {\textless}italic{\textgreater}d{\textless}/italic{\textgreater} systems, we demonstrate that the interplay between crystal symmetry and electron correlation can significantly enhance the SOC effect in certain partially occupied orbital multiplets through the self-consistently reinforced orbital polarization as a pivot. Thereafter, we provide design principles and comprehensive databases, where we list all the Wyckoff positions and site symmetries in all two-dimensional (2D) and three-dimensional crystals that could have enhanced SOC effect. Additionally, we predict nine material candidates from our selected 2D material pool as high-temperature quantum anomalous Hall insulators with large nontrivial band gaps of hundreds of meV. Our study provides an efficient and straightforward way for predicting promising SOC-active materials, relieving the use of heavy elements for next-generation spin-orbitronic materials and devices. {\textless}/p{\textgreater}},
	number = {1},
	urldate = {2023-03-28},
	journal = {Nature Communications},
	author = {Li, Jiayu and Yao, Qiushi and Wu, Lin and Hu, Zongxiang and Gao, Boya and Wan, Xiangang and Liu, Qihang},
	month = feb,
	year = {2022},
	note = {Publisher: Nature Publishing Group},
	keywords = {Electronic properties and materials, Topological matter},
	pages = {919},
}

