@article{emtageConductionSmallPolarons1971,
	title = {Conduction by small polarons in large electric fields},
	volume = {3},
	issn = {01631829},
	url = {http://link.aps.org/doi/10.1103/PhysRevB.3.2685},
	doi = {10.1103/PhysRevB.3.2685},
	abstract = {The bandwidth of small polarons at low temperatures is so narrow f-10 3 (optical phonon energy)) that an electric field of the order of 103 V/cm produces a potential difference between neighboring atoms that is comparable with the bandwidth. It is shown that the electron states are then localized and that charge transport proceeds by hopping from site to site, the con-ductivity being much less than the low-field conductivity by nonlocal electrons. The field-in-duced transition from band to hopping modes of transport is marked by a region of constant current or negative resistance; at higher fieMs conduction remains Ohmic until fields of the order of 10 V/cm are reached.},
	number = {8},
	urldate = {2016-10-11},
	journal = {Physical Review B},
	author = {Emtage, P. R.},
	month = apr,
	year = {1971},
	pages = {2685--2689},
}

@article{nianEvidenceOxygenDiffusion2007,
	title = {Evidence for an oxygen diffusion model for the electric pulse induced resistance change effect in transition-metal oxides},
	volume = {98},
	issn = {00319007},
	url = {http://link.aps.org/doi/10.1103/PhysRevLett.98.146403},
	doi = {10.1103/PhysRevLett.98.146403},
	abstract = {Electric-pulse induced resistance hysteresis switching loops for Pr0.7Ca0.3MnO3 perovskite oxide films were found to exhibit an additional sharp "shuttle tail" peak around the negative pulse maximum for films deposited in an oxygen-deficient ambient. The resistance relaxation in time of this "shuttle tail" peak as well as resistance relaxation in the transition regions of the resistance hysteresis loop show evidence of oxygen diffusion under electric pulsing, and support a proposed oxygen diffusion model with oxygen vacancy pileup at the metal electrode interface region as the active process for the nonvolatile resistance switching effect in transition-metal oxides.},
	number = {14},
	urldate = {2016-10-10},
	journal = {Physical Review Letters},
	author = {Nian, Y. B. and Strozier, J. and Wu, N. J. and Chen, X. and Ignatiev, A.},
	month = apr,
