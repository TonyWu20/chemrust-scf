@article{fattebertDensityFunctionalTheory2002,
	title = {Density functional theory for efficient ab initio molecular dynamics simulations in solution},
	volume = {23},
	copyright = {Copyright © 2002 Wiley Periodicals, Inc.},
	issn = {1096-987X},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/jcc.10069},
	doi = {10.1002/jcc.10069},
	abstract = {We present a density functional for first-principles molecular dynamics simulations that includes the electrostatic effects of a continuous dielectric medium. It allows for numerical simulations of molecules in solution in a model polar solvent. We propose a smooth dielectric model function to model solvation into water and demonstrate its good numerical properties for total energy calculations and constant energy molecular dynamics. © 2002 Wiley Periodicals, Inc. J Comput Chem 23: 662–666, 2002},
	language = {en},
